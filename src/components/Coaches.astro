---
import coachAndre from "../assets/images/coaches/coach-andre.png";
import coachRaka from "../assets/images/coaches/coach-raka.png";
import coachDion from "../assets/images/coaches/coach-dion.png";

const coaches = [
	{
		number: '01',
		name: 'Andre',
		role: 'Strength Coach',
		quote: 'Get stronger today for a better tomorrow.',
		image: coachAndre.src,
	},
	{
		number: '02',
		name: 'Raka',
		role: 'Conditioning Coach',
		quote: 'Move better. Do more.',
		image: coachRaka.src,
	},
	{
		number: '03',
		name: 'Dion',
		role: 'Mobility & Hybrid Coach',
		quote: 'A stronger body for a longer journey.',
		image: coachDion.src,
	},
];
---

<section id="coaches" class="bg-[#0B0B0B] py-20 text-white lg:py-28">
	<div class="mx-auto w-full max-w-[1500px] px-6 lg:px-10">

		<!-- HEADER -->
		<div class="mb-12 grid gap-8 lg:grid-cols-[1.1fr_.9fr] lg:items-end">
			<div>
				<div class="mb-5 flex items-center gap-4">
					<span class="h-[2px] w-7 bg-[#F04A2A]"></span>

					<p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#F04A2A]">
						Our Coaches
					</p>
				</div>

				<h2 class="font-display max-w-[720px] text-[clamp(3.8rem,7vw,7rem)] font-extrabold uppercase leading-[0.82] tracking-[-0.045em]">
					Meet Our
					<br />
					<span class="text-[#F04A2A]">Coaches.</span>
				</h2>
			</div>

			<div class="max-w-[520px] lg:justify-self-end">
				<p class="text-sm leading-[1.8] text-white/55 lg:text-base">
					More than just trainers. Our coaches are here to guide,
					support, and push you to become a stronger version of yourself.
				</p>
			</div>
		</div>

		<!-- COACH GRID -->
		<div class="grid gap-px bg-white/10 lg:grid-cols-3">
			{
				coaches.map((coach) => (
					<article class="group relative min-h-[620px] overflow-hidden bg-[#111]">
						<!-- IMAGE -->
						<img
							src={coach.image}
							alt={`${coach.name} — ${coach.role}`}
							class="absolute inset-0 h-full w-full object-cover grayscale transition duration-700 ease-out group-hover:scale-[1.035] group-hover:grayscale-0"
						/>

						<!-- DARK GRADIENT -->
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-black/10"></div>

						<!-- NUMBER -->
						<div class="absolute left-6 top-6">
							<p class="font-display text-2xl font-extrabold tracking-[-0.04em] text-white/65">
								{coach.number}
							</p>

							<span class="mt-2 block h-[2px] w-10 bg-[#F04A2A]"></span>
						</div>

						<!-- CONTENT -->
						<div class="absolute inset-x-0 bottom-0 p-6 lg:p-8">
							<h3 class="font-display text-[clamp(2.8rem,4vw,4.4rem)] font-extrabold uppercase leading-[0.85] tracking-[-0.04em]">
								{coach.name}
							</h3>

							<p class="mt-3 text-[0.65rem] font-semibold uppercase tracking-[0.25em] text-white/65">
								{coach.role}
							</p>

							<blockquote class="mt-7 max-w-[280px] text-lg italic leading-[1.45] text-white/55">
								“{coach.quote}”
							</blockquote>

							<div class="mt-8 flex items-center justify-between border-t border-white/15 pt-4">
								<span class="text-[0.62rem] font-semibold uppercase tracking-[0.15em] text-white/40">
									Muscle Up
								</span>

								<span class="translate-x-0 text-lg text-[#F04A2A] transition-transform duration-300 group-hover:translate-x-1.5">
									→
								</span>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>