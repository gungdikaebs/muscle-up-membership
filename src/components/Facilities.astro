---
import facilityMain from "../assets/images/facility-main.png";
import facilityEquipment from "../assets/images/facility-equipment.png";
import facilityRecovery from "../assets/images/facility-recovery.png";
const facilities = [
  "Free Weights",
  "Strength Equipment",
  "Functional Training Area",
  "Locker & Shower",
  "Recovery Zone",
  "Clean & Comfortable Space",
];
---

<section id="facilities" class="bg-[#f0eee8] py-20 text-[#111] lg:py-28">
  <div
    class="mx-auto grid w-full max-w-[1500px] gap-12 px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:px-10"
  >
    <!-- LEFT COPY -->
    <div>
      <div class="mb-5 flex items-center gap-4">
        <span class="h-[2px] w-7 bg-[#F04A2A]"></span>

        <p
          class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#F04A2A]"
        >
          Our Facility
        </p>
      </div>

      <h2
        class="font-display max-w-[520px] text-[clamp(3.5rem,6vw,6.5rem)] font-extrabold uppercase leading-[0.82] tracking-[-0.045em]"
      >
        A Space
        <br />
        To
        <span class="text-[#F04A2A]">Progress.</span>
      </h2>

      <p
        class="mt-7 max-w-[470px] text-sm leading-[1.8] text-black/60 lg:text-base"
      >
        A focused training environment built for people who want to move better,
        get stronger, and train without distractions.
      </p>

      <a
        href="#contact"
        class="mt-8 inline-flex items-center gap-8 border-b border-black/35 pb-2 text-[0.7rem] font-semibold uppercase tracking-[0.15em] no-underline transition-opacity hover:opacity-60"
      >
        See Our Facility
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- RIGHT VISUAL -->
    <div class="grid gap-4 lg:grid-cols-[1.4fr_.6fr]">
      <!-- MAIN IMAGE -->
      <div class="relative min-h-[420px] overflow-hidden lg:min-h-[540px]">
        <img
          src={facilityMain.src}
          alt="Muscle Up training facility"
          class="absolute inset-0 h-full w-full object-cover"
        />

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"
        >
        </div>

        <div class="absolute bottom-6 left-6">
          <p class="font-display text-3xl uppercase leading-[0.9] text-white">
            Train hard.
            <br />
            Recover well.
          </p>
        </div>
      </div>

      <!-- SIDE -->
      <div class="flex flex-col gap-4">
        <div class="relative min-h-[190px] flex-1 overflow-hidden">
          <img
            src={facilityEquipment.src}
            alt="Gym strength equipment"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>

        <div class="relative min-h-[190px] flex-1 overflow-hidden">
          <img
            src={facilityRecovery.src}
            alt="Gym recovery space"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- FACILITY LIST -->
  <div class="mx-auto mt-14 w-full max-w-[1500px] px-6 lg:px-10">
    <div class="grid border-t border-black/15 sm:grid-cols-2 lg:grid-cols-3">
      {
        facilities.map((facility, index) => (
          <div class="flex items-center gap-5 border-b border-black/15 py-5 sm:odd:border-r sm:odd:pr-6 sm:even:pl-6 lg:border-r lg:px-6 lg:first:pl-0 lg:nth-[3n]:border-r-0">
            <span class="text-[0.65rem] font-semibold tracking-[0.15em] text-[#F04A2A]">
              0{index + 1}
            </span>

            <p class="text-sm font-semibold uppercase tracking-[0.08em]">
              {facility}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
