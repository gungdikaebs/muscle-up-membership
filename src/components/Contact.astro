<section id="contact" class="bg-[#0B0B0B] py-20 text-white lg:py-28">
  <div
    class="mx-auto grid w-full max-w-[1500px] gap-12 px-6 lg:grid-cols-[0.9fr_1.1fr] lg:px-10"
  >
    <!-- LEFT -->
    <div>
      <div class="mb-5 flex items-center gap-4" data-reveal="editorial">
        <span class="h-[2px] w-7 bg-[#F04A2A]"></span>

        <p
          class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-[#F04A2A]"
        >
          Contact
        </p>
      </div>

      <h2
        class="font-display max-w-[700px] text-[clamp(4rem,7vw,7rem)] font-extrabold uppercase leading-[0.8] tracking-[-0.05em]"
        data-reveal="editorial"
      >
        Ready To
        <br />
        <span class="text-[#F04A2A]"> Start? </span>
      </h2>

      <p
        class="mt-8 max-w-[520px] text-sm leading-[1.8] text-white/55 lg:text-base"
        data-reveal="editorial"
      >
        Have questions about membership, training programs, or facilities? Send
        us a message and our team will get back to you.
      </p>

      <div class="mt-12 grid gap-8 sm:grid-cols-2" data-reveal="editorial">
        <div>
          <p
            class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-white/30"
          >
            Location
          </p>

          <p class="mt-3 text-sm leading-[1.7] text-white/70">
            Denpasar, Bali
            <br />
            Indonesia
          </p>
        </div>

        <div>
          <p
            class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-white/30"
          >
            Opening Hours
          </p>

          <p class="mt-3 text-sm leading-[1.7] text-white/70">
            Mon — Fri · 06:00 — 22:00
            <br />
            Sat — Sun · 07:00 — 20:00
          </p>
        </div>

        <div>
          <p
            class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-white/30"
          >
            Email
          </p>

          <a
            href="mailto:hello@muscleup.fit"
            class="mt-3 inline-block text-sm text-white/70 no-underline transition-colors hover:text-[#F04A2A]"
          >
            hello@muscleup.fit
          </a>
        </div>

        <div>
          <p
            class="text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-white/30"
          >
            Phone
          </p>

          <a
            href="tel:+6281234567890"
            class="mt-3 inline-block text-sm text-white/70 no-underline transition-colors hover:text-[#F04A2A]"
          >
            +62 812 3456 7890
          </a>
        </div>
      </div>
    </div>

    <!-- FORM -->
    <div
      class="border border-white/10 bg-[#111] p-6 lg:p-8"
      data-reveal="group"
      data-reveal-order="1"
    >
      <div class="mb-8 flex items-center justify-between">
        <p
          class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-white/40"
        >
          Send a Message
        </p>

        <span class="text-[0.62rem] uppercase tracking-[0.16em] text-[#F04A2A]">
          01 / 01
        </span>
      </div>

      <form class="space-y-7">
        <div class="grid gap-7 sm:grid-cols-2">
          <div>
            <label
              for="name"
              class="mb-2 block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/35"
            >
              Name
            </label>

            <input
              id="name"
              name="name"
              type="text"
              placeholder="Your name"
              class="w-full border-0 border-b border-white/15 bg-transparent px-0 py-3 text-sm text-white outline-none placeholder:text-white/20 focus:border-[#F04A2A]"
            />
          </div>

          <div>
            <label
              for="email"
              class="mb-2 block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/35"
            >
              Email
            </label>

            <input
              id="email"
              name="email"
              type="email"
              placeholder="you@example.com"
              class="w-full border-0 border-b border-white/15 bg-transparent px-0 py-3 text-sm text-white outline-none placeholder:text-white/20 focus:border-[#F04A2A]"
            />
          </div>
        </div>

        <div>
          <label
            for="subject"
            class="mb-2 block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/35"
          >
            Subject
          </label>

          <select
            id="subject"
            name="subject"
            class="w-full border-0 border-b border-white/15 bg-transparent px-0 py-3 text-sm text-white outline-none focus:border-[#F04A2A]"
          >
            <option class="bg-[#111]" value="membership"> Membership </option>

            <option class="bg-[#111]" value="program">
              Training Program
            </option>

            <option class="bg-[#111]" value="facility"> Facility </option>

            <option class="bg-[#111]" value="other"> Other </option>
          </select>
        </div>

        <div>
          <label
            for="message"
            class="mb-2 block text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/35"
          >
            Message
          </label>

          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Tell us what you need..."
            class="w-full resize-none border-0 border-b border-white/15 bg-transparent px-0 py-3 text-sm leading-[1.7] text-white outline-none placeholder:text-white/20 focus:border-[#F04A2A]"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group flex w-full items-center justify-between bg-[#F04A2A] px-5 py-4 text-[0.7rem] font-bold uppercase tracking-[0.15em] text-white transition-colors hover:bg-white hover:text-black"
        >
          Send Message

          <span
            class="transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </button>
      </form>
    </div>
  </div>
</section>
