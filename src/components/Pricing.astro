---
const plans = [
	{
		number: '01',
		name: 'Starter',
		label: 'Training Pass',
		price: '299K',
		description:
			'For people who want consistent access and a simple training routine.',
		features: [
			'Unlimited gym access',
			'Free weights area',
			'Functional training zone',
			'Locker access',
		],
		featured: false,
	},
	{
		number: '02',
		name: 'Standard',
		label: 'Full Access',
		price: '499K',
		description:
			'Our most balanced membership for consistent progress and flexibility.',
		features: [
			'Unlimited gym access',
			'All training zones',
			'Weekly group class',
			'Locker & shower access',
			'Basic training consultation',
		],
		featured: true,
	},
	{
		number: '03',
		name: 'Pro',
		label: 'Performance',
		price: '799K',
		description:
			'For serious members who want structure, coaching, and faster progress.',
		features: [
			'Unlimited gym access',
			'All group classes',
			'Monthly coach session',
			'Training assessment',
			'Recovery area access',
		],
		featured: false,
	},
];
---

<section
	id="pricing"
	class="relative overflow-hidden bg-[#090909] py-24 text-white lg:py-32"
>
	<!-- BACKGROUND DETAIL -->
	<div
		class="pointer-events-none absolute inset-0 opacity-[0.035]"
		style="background-image:
			linear-gradient(rgba(255,255,255,.09) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,.09) 1px, transparent 1px);
			background-size: 72px 72px;"
		aria-hidden="true"
	></div>

	<div class="relative mx-auto w-full max-w-[1500px] px-6 lg:px-10">

		<!-- HEADER -->
		<div class="mb-16 grid gap-10 lg:grid-cols-[1.15fr_.85fr] lg:items-end">
			<div>
				<div class="mb-5 flex items-center gap-4">
					<span class="h-[2px] w-7 bg-[#F04A2A]"></span>

					<p class="text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-[#F04A2A]">
						Membership
					</p>
				</div>

				<h2
					class="font-display max-w-[760px] text-[clamp(4rem,7.2vw,7.4rem)] font-extrabold uppercase leading-[0.8] tracking-[-0.05em]"
				>
					Choose Your
					<br />
					<span class="text-[#F04A2A]">
						Commitment.
					</span>
				</h2>
			</div>

			<div class="max-w-[520px] lg:justify-self-end">
				<p class="text-sm leading-[1.8] text-white/50 lg:text-base">
					Simple memberships built around how often you train
					and how far you want to push your progress.
				</p>

				<div class="mt-6 flex items-center gap-4 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-white/35">
					<span>No hidden fees</span>
					<span class="h-px w-8 bg-white/20"></span>
					<span>Cancel anytime</span>
				</div>
			</div>
		</div>

		<!-- PRICING -->
		<div class="grid items-stretch gap-4 lg:grid-cols-3 lg:gap-0">
			{
				plans.map((plan) => (
					<article
						class:list={[
							'group relative flex min-h-[620px] flex-col overflow-hidden border p-7 transition duration-300 lg:p-8',
							plan.featured
								? 'z-10 border-[#F04A2A] bg-[#F04A2A] text-white lg:-translate-y-6 lg:min-h-[670px] lg:shadow-[0_30px_70px_rgba(0,0,0,.35)]'
								: 'border-white/10 bg-[#111] text-white hover:border-white/20',
						]}
					>
						<!-- TOP META -->
						<div class="flex items-start justify-between">
							<div>
								<p
									class:list={[
										'text-[0.62rem] font-semibold uppercase tracking-[0.18em]',
										plan.featured
											? 'text-white/65'
											: 'text-white/35',
									]}
								>
									{plan.number}
								</p>

								<p
									class:list={[
										'mt-8 text-[0.65rem] font-semibold uppercase tracking-[0.22em]',
										plan.featured
											? 'text-white/75'
											: 'text-[#F04A2A]',
									]}
								>
									{plan.label}
								</p>
							</div>

							{
								plan.featured && (
									<span class="border border-white/35 px-3 py-2 text-[0.58rem] font-bold uppercase tracking-[0.17em] text-white">
										Most Popular
									</span>
								)
							}
						</div>

						<!-- PLAN NAME -->
						<h3
							class="font-display mt-3 text-[clamp(3rem,4vw,4.6rem)] font-extrabold uppercase leading-none tracking-[-0.045em]"
						>
							{plan.name}
						</h3>

						<!-- PRICE -->
						<div class="mt-12">
							<p
								class:list={[
									'text-[0.6rem] font-semibold uppercase tracking-[0.2em]',
									plan.featured
										? 'text-white/60'
										: 'text-white/30',
								]}
							>
								Monthly
							</p>

							<div class="mt-2 flex items-start gap-3">
								<span
									class:list={[
										'mt-3 text-sm font-semibold',
										plan.featured
											? 'text-white/75'
											: 'text-white/60',
									]}
								>
									Rp
								</span>

								<div>
									<p
										class="font-display text-[clamp(5rem,7vw,7.2rem)] font-extrabold leading-[0.82] tracking-[-0.06em]"
									>
										{plan.price}
									</p>

									<p
										class:list={[
											'mt-3 text-[0.6rem] uppercase tracking-[0.2em]',
											plan.featured
												? 'text-white/60'
												: 'text-white/30',
										]}
									>
										Per month
									</p>
								</div>
							</div>
						</div>

						<!-- DESCRIPTION -->
						<p
							class:list={[
								'mt-8 max-w-[340px] text-sm leading-[1.8]',
								plan.featured
									? 'text-white/85'
									: 'text-white/50',
							]}
						>
							{plan.description}
						</p>

						<!-- FEATURES -->
						<div class="mt-8">
							<p
								class:list={[
									'mb-3 text-[0.58rem] font-semibold uppercase tracking-[0.18em]',
									plan.featured
										? 'text-white/55'
										: 'text-white/25',
								]}
							>
								Includes
							</p>

							<ul>
								{
									plan.features.map((feature) => (
										<li
											class:list={[
												'flex items-center gap-3 border-t py-4 text-sm',
												plan.featured
													? 'border-white/20 text-white/85'
													: 'border-white/10 text-white/55',
											]}
										>
											<span
												class:list={[
													'h-[5px] w-[5px] shrink-0',
													plan.featured
														? 'bg-white'
														: 'bg-[#F04A2A]',
												]}
											></span>

											{feature}
										</li>
									))
								}
							</ul>
						</div>

						<!-- CTA -->
						<div class="mt-auto pt-8">
							<a
								href="#contact"
								class:list={[
									'group/button flex items-center justify-between border px-5 py-[1.1rem] text-[0.66rem] font-bold uppercase tracking-[0.16em] no-underline transition duration-200',
									plan.featured
										? 'border-white bg-white text-black hover:bg-black hover:text-white'
										: 'border-white/15 bg-transparent text-white hover:border-white hover:bg-white hover:text-black',
								]}
							>
								<span>
									Choose Plan
								</span>

								<span
									class="transition-transform duration-200 group-hover/button:translate-x-1"
									aria-hidden="true"
								>
									→
								</span>
							</a>
						</div>
					</article>
				))
			}
		</div>

		<!-- FOOT NOTE -->
		<div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-[0.6rem] font-medium uppercase tracking-[0.18em] text-white/30">
				No registration fee.
			</p>

			<p class="text-[0.6rem] font-medium uppercase tracking-[0.18em] text-white/30">
				Cancel or upgrade anytime.
			</p>
		</div>
	</div>
</section>