---
import { Image } from "astro:assets";
import { programs } from "../data/programs";
---

<section id="programs" class="bg-[#0B0B0B] py-20 text-white lg:py-28">
  <div class="mx-auto w-full max-w-[1500px] px-6 lg:px-10">
    <div class="grid gap-12 lg:grid-cols-[280px_1fr] lg:gap-14">
      <div data-reveal="editorial">
        <div class="mb-5 flex items-center gap-4">
          <span class="h-[2px] w-7 bg-[#F04A2A]"></span>
          <p
            class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[#F04A2A]"
          >
            Our Programs
          </p>
        </div>

        <h2
          class="font-display text-[clamp(3.5rem,6vw,6rem)] font-extrabold uppercase leading-[0.82] tracking-[-0.045em]"
        >
          Train
          <br />
          With
          <br />
          Purpose.
        </h2>
      </div>

      <div class="grid gap-px bg-white/10 sm:grid-cols-2 xl:grid-cols-4">
        {
          programs.map((program, index) => (
            <a
              href={`/programs/${program.slug}`}
              aria-label={`Explore ${program.title}`}
              class="group relative min-h-[360px] overflow-hidden bg-[#111] no-underline"
              data-reveal="group"
              data-reveal-order={index + 1}
            >
              <Image
                src={program.image}
                alt=""
                class="absolute inset-0 h-full w-full object-cover grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0"
                layout="full-width"
                loading="lazy"
                decoding="async"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent" />

              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="mb-3 text-[0.65rem] font-semibold tracking-[0.15em] text-[#F04A2A]">
                  {program.number}
                </p>

                <h3 class="font-display text-2xl font-extrabold uppercase">
                  {program.title}
                </h3>

                <p class="mt-2 max-w-[14rem] text-sm leading-relaxed text-white/65">
                  {program.description}
                </p>

                <div class="mt-5 flex items-center justify-between">
                  <span class="text-[0.65rem] font-semibold uppercase tracking-[0.14em]">
                    Explore
                  </span>

                  <span class="text-lg transition-transform group-hover:translate-x-1">
                    →
                  </span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
