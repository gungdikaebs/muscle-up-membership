---
const base = import.meta.env.BASE_URL;

const links = [
  { label: "Home", href: `${base}#home` },
  { label: "About", href: `${base}#about` },
  { label: "Programs", href: `${base}#programs` },
  { label: "Facilities", href: `${base}#facilities` },
  { label: "Coaches", href: `${base}#coaches` },
  { label: "Pricing", href: `${base}#pricing` },
  { label: "Contact", href: `${base}#contact` },
];
---

<header class="sticky inset-x-0 top-0 z-50 border-b border-white/10 bg-[#090909]/80 text-white backdrop-blur-md">
  <nav
    class="mx-auto flex w-full max-w-[1500px] items-center justify-between px-6 py-6 lg:px-10"
    data-intro="nav"
  >
    <a
      href={`${base}#home`}
      class="flex items-center gap-4 no-underline"
      aria-label="Muscle Up home"
    >
      <span class="text-xl font-black uppercase italic tracking-[-0.04em]">
        Muscle Up
      </span>

      <span class="hidden h-7 w-px bg-white/30 sm:block"></span>

      <span
        class="hidden text-[0.62rem] font-medium uppercase leading-[1.35] tracking-[0.28em] text-white/55 sm:block"
      >
        Training Club
        <br />
        Bali
      </span>
    </a>

    <div class="hidden items-center gap-9 lg:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="relative py-2 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-white/80 no-underline transition-colors hover:text-white after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0 after:bg-[#F04A2A] after:transition-transform hover:after:origin-left hover:after:scale-x-100"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={`${base}#pricing`}
      class="hidden items-center gap-6 bg-[#F04A2A] px-6 py-4 text-[0.7rem] font-bold uppercase tracking-[0.14em] text-black no-underline transition-colors hover:bg-white lg:inline-flex"
    >
      Join Now
      <span aria-hidden="true">→</span>
    </a>

    <button
      type="button"
      class="flex h-11 w-11 flex-col items-center justify-center gap-1.5 border border-white/25 transition-colors hover:border-[#F04A2A] lg:hidden"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-toggle
    >
      <span class="h-px w-5 bg-white"></span>
      <span class="h-px w-5 bg-white"></span>
    </button>
  </nav>

  <nav
    id="mobile-navigation"
    class="absolute inset-x-0 top-full border-y border-white/10 bg-[#090909]/95 px-6 py-4 backdrop-blur-md lg:hidden"
    aria-label="Mobile navigation"
    hidden
    data-mobile-menu
  >
    <div class="mx-auto flex w-full max-w-[1500px] flex-col">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="border-b border-white/10 py-4 text-xs font-semibold uppercase tracking-[0.18em] text-white/75 no-underline transition-colors hover:text-[#F04A2A]"
            data-menu-link
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={`${base}#pricing`}
        class="mt-4 flex items-center justify-between bg-[#F04A2A] px-5 py-4 text-xs font-bold uppercase tracking-[0.16em] text-black no-underline transition-colors hover:bg-white"
        data-menu-link
      >
        Join Now <span aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  if (menuToggle && mobileMenu) {
    const closeMenu = () => {
      mobileMenu.hidden = true;
      menuToggle.setAttribute("aria-expanded", "false");
      menuToggle.setAttribute("aria-label", "Open navigation");
    };

    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      mobileMenu.hidden = isOpen;
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
    });

    mobileMenu.querySelectorAll("[data-menu-link]").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });
  }
</script>
